       "type": "AnimationSample.ChainIkStation",
       "@slot": "0c7010fc-691f-d94e-8651-27e92eab1969",
       "ArmTip": {
        "flags": 2,
        "uid": "10d9a339-ca90-2a48-afb3-2610ab025b7b"
       },
       "TentacleTip": {
        "flags": 2,
        "uid": "4a884d3b-9e11-e942-a052-2ba961345563"
