       "HeroPoint": {
        "flags": 2,
        "uid": "1f68b5ab-30af-7648-9ba6-17320a0e0a15"
       },
       "ReachDistance": 4.0,
       "Title": "Chain IK",
       "Description": "Chain IK solves any number of bones toward a target: FABRIK (smooth, fast, here with a pole keeping the elbow up) for the robot arm chasing the drone, CCD (curls the tip first) for the tentacle, which reaches for you when you come close. Swapping the target does not snap it: Smoothing eases the goal from where the tip was. Both rigs are plain entities - no skinned mesh needed.",
       "Radius": 6.0,
       "Focus": {
        "flags": 2,
        "uid": "5be8d032-2e05-6249-ba90-6f0f56abd5c6"
       }
      }
     ]
    }
