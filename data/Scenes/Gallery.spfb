    "script_component": {
     "script_components": [
      {
       "type": "AnimationSample.SpringStation",
       "@slot": "fb6e54a5-1b20-d344-8f89-f633032232bf",
       "Strands": {
        "flags": 2,
        "uid": "8791037e-757b-9e49-bdd2-470b1c18a5f5"
       },
       "Ball": {
        "flags": 2,
        "uid": "9e12738c-e4ab-5a4b-85b3-bba487398326"
       },
       "BallRadius": 0.30000001192092898,
       "Title": "Spring Bones",
       "Description": "Secondary motion on top of the animated pose: every joint is a damped particle pulled back toward its animated direction (stiffness), slowed (damping) and pulled down (gravity), simulated at a fixed rate. The bead strands part around the swinging ball - a sphere collider - and the lanterns sway under the beam. Your charm swings as you run.",
       "Radius": 4.199999809265137,
       "Focus": {
        "flags": 2,
        "uid": "b59c748e-cd3c-5745-a99a-1c3db52151b6"
       }
      }
     ]
    }
   }
