     "script_components": [
      {
       "type": "AnimationSample.FootIkStation",
       "@slot": "0945ea74-705c-684c-a71e-436c213389b3",
       "WithIk": {
        "flags": 2,
        "uid": "6f935919-fa77-c84c-b9d6-5bfff3a9532c"
       },
       "WithoutIk": {
        "flags": 2,
        "uid": "e0e31a1f-0597-3741-8b0d-c7a18a5bcd3a"
       },
       "Title": "Foot IK",
       "Description": "Two walkers, one path over steps, a slope and stones. The first has a Foot IK component: ground probes under each foot, the pelvis drops to the lower foot, two-bone IK plants each leg and tilts the foot onto the slope, swing feet stay as animated. The second walks the clip as authored. Walk here yourself too.",
       "Radius": 6.5,
       "Focus": {
        "flags": 2,
        "uid": "3093f5ff-c359-1645-8142-bda434833780"
       }
      }
     ]
    }
   }
